# 默认按内容自动判断文本/二进制，文本统一 LF
* text=auto eol=lf

# Windows 批处理必须是 CRLF，且内容保持纯 ASCII（见 README 踩坑记录 T4）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件，禁止任何行尾/编码转换
*.exe binary
*.dll binary
*.img binary
*.bin binary
*.zip binary
*.tar binary
*.png binary
*.ico binary

# 语言与工具
*.py text diff=python
*.md text
